# Supabase — get these from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# For CLI ingestion scripts (Supabase Dashboard → Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# For applying migrations (Dashboard → Settings → Database → Connection string URI)
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Production site URL for sitemap/SEO (optional locally)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# OpenTrailMap styles (optional — defaults to https://opentrailmap.us)
NEXT_PUBLIC_OPENTRAILMAP_URL=https://opentrailmap.us

# OpenSkiMap API for resort search only (optional)
NEXT_PUBLIC_SKI_API_URL=https://api.openskimap.org

# Admin dashboard (Phase 1 — simple secret gate)
ADMIN_SECRET=change-me-in-production
