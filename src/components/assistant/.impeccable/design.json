      "css": ".ds-label{display:block;color:var(--cream,#f5f0e6);font-size:12px;font-weight:500;font-family:var(--font-inter,Inter),Inter,system-ui,sans-serif;}.ds-input{display:block;width:100%;margin-top:7px;border:1px solid var(--plan-line,#3d473a);border-radius:6px;background:var(--forest,#0d120d);color:var(--cream,#f5f0e6);padding:11px 12px;font-size:14px;line-height:1.4;font-family:var(--font-inter,Inter),Inter,system-ui,sans-serif;caret-color:var(--accent,#c8f04a)}.ds-input::placeholder{color:var(--plan-muted,#adb7a7);opacity:1}.ds-input:focus-visible{outline:2px solid var(--accent,#c8f04a);outline-offset:4px;}@media(max-width:760px){.ds-input{font-size:16px}}"
