      "html": "<label class=\"ds-field\">Search trails<input type=\"search\" placeholder=\"Trail name or place\"></label>",
      "css": ".ds-field{display:grid;gap:8px;color:var(--foreground,#18251f);font-size:14px;font-family:var(--font-inter,Inter,sans-serif);}.ds-field input{min-width:0;height:44px;border:1px solid var(--border,#d9e1d9);border-radius:8px;padding:0 12px;background:var(--surface,#fff);color:var(--foreground,#18251f);font:inherit;font-size:16px;caret-color:var(--accent,#245b47)}.ds-field input::placeholder{color:var(--sage,#59665e)}.ds-field input:focus{outline:2px solid var(--accent,#245b47);outline-offset:2px}"
