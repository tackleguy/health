      "html": "<button class=\"ds-primary\">Plan this trip</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border:1px solid transparent;border-radius:8px;padding:12px 20px;background:var(--accent,#245b47);color:#fff;font-size:14px;font-weight:600;line-height:1.4;font-family:var(--font-inter,Inter,sans-serif);cursor:pointer;transition:background-color 160ms ease-out}.ds-primary:hover{background:var(--accent-dim,#173f35)}.ds-primary:focus-visible{outline:2px solid var(--accent,#245b47);outline-offset:4px;}.ds-primary:disabled{cursor:not-allowed;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
